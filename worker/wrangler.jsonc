{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sali-photo-api",
  "main": "index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "kv_namespaces": [
    { "binding": "GALLERY", "id": "7dbb365a2b46426fa26091a446e4483d" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CATALOG", "class_name": "CatalogStore" }]
  },
  "migrations": [
    { "tag": "catalog-store-v1", "new_sqlite_classes": ["CatalogStore"] }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ]
}
